# Ensure all text files use LF line endings
* text=auto eol=lf

# Explicitly set line endings for specific file types
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.xml text eol=lf
*.txt text eol=lf
*.sh text eol=lf

# Binary files should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary

# Retain upstream notice bytes and whitespace; recorded SHA-256 verifies them.
containers/node/npm-notices/files/** -text -whitespace
containers/node/npm-notices/native/** -text -whitespace

# Original hash-addressed source recipe and patch payloads.
containers/node/source-inputs/* -text -diff
