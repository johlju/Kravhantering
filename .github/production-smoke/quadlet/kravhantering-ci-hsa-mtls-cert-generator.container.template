[Unit]
Description=Kravhantering CI-only HSA mTLS certificate generator
Requires=kravhantering-single-node-egress-network.service kravhantering-ci-hsa-mtls-certs-volume.service
After=kravhantering-single-node-egress-network.service kravhantering-ci-hsa-mtls-certs-volume.service
Before=kravhantering-ci-hsa-directory-mock.service

[Container]
ContainerName=kravhantering-ci-hsa-mtls-cert-generator
Image=@@HSA_PERSON_LOOKUP_ADAPTER_IMAGE_REF@@
Exec=node src/generate-certs.mjs
Network=kravhantering-single-node-egress.network
Volume=kravhantering-ci-hsa-mtls-certs.volume:/run/hsa-mtls
NoNewPrivileges=true
DropCapability=all

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=120
