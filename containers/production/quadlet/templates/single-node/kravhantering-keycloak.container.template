[Unit]
Description=Kravhantering Keycloak
PartOf=kravhantering-single-node.target
Requires=kravhantering-single-node-identity-network.service kravhantering-keycloak-data-volume.service
After=kravhantering-single-node-identity-network.service kravhantering-keycloak-data-volume.service

[Container]
ContainerName=kravhantering-keycloak
Image=@@KEYCLOAK_IMAGE_REF@@
Exec=start --import-realm
EnvironmentFile=/etc/kravhantering/keycloak.env
Network=kravhantering-single-node-identity.network
PodmanArgs=--network-alias=keycloak
Volume=/etc/kravhantering/keycloak/realm-kravhantering-production.json:/opt/keycloak/data/import/realm-kravhantering-production.json:ro
Volume=kravhantering-keycloak-data.volume:/opt/keycloak/data:U
Tmpfs=/tmp:rw,size=512M,mode=1777,nosuid,nodev,noexec

[Service]
Restart=always
TimeoutStartSec=180
TimeoutStopSec=90
