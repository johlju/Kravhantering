[Unit]
Description=Kravhantering nginx TLS edge
PartOf=kravhantering-app-node.target
Requires=kravhantering-app-runtime.service
After=kravhantering-app-runtime.service

[Container]
ContainerName=kravhantering-nginx
Image=@@NGINX_IMAGE_REF@@
User=101:101
DropCapability=all
NoNewPrivileges=true
ReadOnly=true
ReadOnlyTmpfs=false
PidsLimit=@@NGINX_PIDS_LIMIT@@
LogDriver=journald
Environment=NGINX_RESOLVER=@@NGINX_RESOLVER@@
PublishPort=@@NGINX_HTTPS_PUBLISH@@
Network=kravhantering-app-node-edge.network
NetworkAlias=nginx
Tmpfs=/etc/nginx/conf.d:rw,size=1M,mode=0755,uid=101,gid=101,nosuid,nodev,noexec
Tmpfs=/var/cache/nginx:rw,size=@@NGINX_CACHE_TMPFS_MIB@@M,mode=0750,uid=101,gid=101,nosuid,nodev,noexec
Tmpfs=/run:rw,size=1M,mode=0755,uid=101,gid=101,nosuid,nodev,noexec
Volume=@@BUNDLE_ROOT@@/nginx/nginx.conf:/etc/nginx/nginx.conf:ro
Volume=@@BUNDLE_ROOT@@/nginx/templates/app-node-tls.conf.template:/etc/nginx/templates/default.conf.template:ro
Volume=@@BUNDLE_ROOT@@/nginx/templates/api-docs-security-headers.conf:/etc/nginx/snippets/api-docs-security-headers.conf:ro
Volume=@@BUNDLE_ROOT@@/nginx/templates/generated-output-locations.conf:/etc/nginx/snippets/generated-output-locations.conf:ro
Volume=@@BUNDLE_ROOT@@/api-docs:/usr/share/nginx/html/api-docs:ro
Volume=/etc/kravhantering/tls/fullchain.pem:/etc/nginx/tls/fullchain.pem:ro
Volume=/etc/kravhantering/tls/privkey.pem:/etc/nginx/tls/privkey.pem:ro

[Service]
Restart=always
TimeoutStartSec=180
TimeoutStopSec=90
MemoryMax=@@NGINX_MEMORY_LIMIT_MIB@@M
CPUQuota=@@NGINX_CPU_QUOTA_PERCENT@@%
TasksMax=@@NGINX_TASKS_MAX@@
LogRateLimitIntervalSec=@@NGINX_LOG_RATE_INTERVAL_SECONDS@@s
LogRateLimitBurst=@@NGINX_LOG_RATE_BURST@@
StandardOutput=journal
StandardError=journal
